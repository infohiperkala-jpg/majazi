POSTGRES_DB=majazi
POSTGRES_USER=majazi
POSTGRES_PASSWORD=change-this-local-password
ConnectionStrings__Default=Host=postgres;Port=5432;Database=majazi;Username=majazi;Password=change-this-local-password
NEXT_PUBLIC_API_BASE_URL=http://localhost:5080
JWT_SIGNING_KEY=replace-with-a-random-secret-at-least-32-bytes-long
JWT_ISSUER=majazi-api
JWT_AUDIENCE=majazi-web
PUBLIC_BASE_URL=https://your-domain.example

# Instagram Business Login (Meta)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://your-domain.example/backend-api/api/meta/oauth/callback
META_FRONTEND_RETURN_URL=https://your-domain.example/channels?meta=connected

# OpenAI-compatible AI content generation (keep the API key server-side)
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
